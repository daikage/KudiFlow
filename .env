APP_NAME="SME Automation"
APP_ENV=local
APP_KEY=base64:GENERATED_KEY_HERE
APP_DEBUG=true
APP_URL=http://kudiflow.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sme_automation
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# If your UI runs on a different domain/port, set CORS later